# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/aniceta?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string

# ── Admin credentials ─────────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# ── Cloudinary (for image uploads) ───────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Email (Namecheap Private Email via SMTP) ──────────────────────────────────
EMAIL_USER=theadmin@bgv-asq.com
EMAIL_PASS=your-private-email-password
NOTIFY_EMAIL=theadmin@bgv-asq.com
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=https://anicetalawfirm.vercel.app,https://gavsbq.com,https://www.gavsbq.com
